# Ollama Configuration
OLLAMA_HOST=http://localhost
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=phi3:mini # Or llama2, llama3, etc. Ensure this model is pulled in Ollama.
OLLAMA_REQUEST_TIMEOUT=300 # Request timeout in seconds

# ChromaDB Configuration
CHROMADB_HOST=localhost # ChromaDB client typically doesn't need http:// scheme here
CHROMADB_PORT=8000
CHROMADB_DEFAULT_COLLECTION_NAME=baby_zero_main_store
CHROMADB_EXPERIENCE_COLLECTION_NAME=baby_zero_experience_store

# Agent Configuration
AGENT_DEFAULT_PERSONA="A helpful and autonomous AI assistant focused on achieving its objectives."
AGENT_MAX_INTERACTIONS=50 # Maximum number of iterations in the self-play loop for a single objective

# Logging Configuration
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TO_FILE=False # True or False
LOG_FILE_PATH=agent_zero.log # Path to log file if LOG_TO_FILE is True
